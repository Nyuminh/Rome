<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Shooter/Scripts/Runtime/Framework/WeaponHUD.uss?fileID=7433441132597879392&amp;guid=bbc435f537f5943b29f02366a419c599&amp;type=3#WeaponHUD"/>
    <ui:VisualElement name="weapon-info-container">
        <ui:Label name="weapon-type-label" text="Weapon Name"/>
        <ui:Image name="weapon-icon"/>
        <ui:VisualElement name="ammo-container">
            <ui:Label name="ammo-label" text="0 / 0"/>
            <ui:ProgressBar value="22" title="my-progress" name="player-ammo-bar" class="blocks-progress-bar blocks-ammo-bar"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="health-info-container">
        <ui:Label text="HEALTH" class="stat-label"/>
        <ui:ProgressBar value="63.8" title="100/100" name="player-health-bar" class="rome-progress-bar"/>
        <ui:Label text="STAMINA" class="stat-label"/>
        <ui:ProgressBar name="player-stamina-bar" low-value="0" high-value="100" value="100" class="rome-progress-bar"/>
    </ui:VisualElement>
    <ui:VisualElement name="notification-container" class="notification-container"/>
    
    <ui:VisualElement name="blood-splatter-overlay"/>
    
    <ui:VisualElement name="enemy-health-container">
        <ui:Label name="enemy-health-label" text="LION"/>
        <ui:ProgressBar value="100" title="100/100" name="enemy-health-bar" class="blocks-progress-bar" high-value="100"/>
    </ui:VisualElement>

    <ui:VisualElement name="win-lose-menu">
        <ui:VisualElement name="win-lose-backdrop"/>
        <ui:VisualElement name="win-lose-panel">
            <ui:VisualElement name="panel-top-ornament"/>
            <ui:Label name="result-icon" text="&#x2694;"/>
            <ui:Label name="result-title" text="VICTORY!"/>
            <ui:VisualElement name="panel-divider"/>
            <ui:Label name="result-subtitle" text="You survived the arena."/>
            <ui:VisualElement name="panel-buttons">
                <ui:Button name="restart-button" text="PLAY AGAIN" class="rome-button"/>
                <ui:Button name="quit-button" text="MAIN MENU" class="rome-button rome-button-secondary"/>
            </ui:VisualElement>
            <ui:VisualElement name="panel-bottom-ornament"/>
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="reticle-container">
        <ui:VisualElement name="player-reticle"/>
    </ui:VisualElement>
    <ui:VisualElement name="message-overlay" style="display: none;">
        <ui:Label name="message-label" text="RESPAWN IN"/>
        <ui:VisualElement name="message-divider"/>
        <ui:Label name="countdown-label" text="05"/>
    </ui:VisualElement>
</ui:UXML>
