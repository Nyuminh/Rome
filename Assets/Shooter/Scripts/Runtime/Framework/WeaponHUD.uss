#hud-root {
    position: absolute;
    width: 100%;
    height: 100%;
}

#weapon-info-container,
#health-info-container {
    position: absolute;
    bottom: 20px;
    background-color: rgba(10, 10, 10, 0.85);
    padding: 15px;
    border-radius: 4px;
    border-width: 2px;
    border-color: rgb(218, 165, 32); /* Golden border for Rome theme */
    width: 320px;
}

#weapon-info-container {
    right: 20px;
    left: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end; /* Align children to the right */
}

#health-info-container {
    right: 20px;
    left: auto;
    bottom: 130px; /* Above the weapon info container */
}

#enemy-health-container {
    position: absolute;
    left: 20px;
    top: 50%;
    translate: 0 -50%;
    width: 300px;
    background-color: rgba(0, 0, 0, 0.4);
    padding: 15px;
    border-radius: 8px;
    display: flex;
}

#enemy-health-label {
    font-size: 20px;
    color: white;
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px rgb(0, 0, 0);
    margin-bottom: 5px;
}

#enemy-health-bar {
    width: 100%;
    height: 30px;
    min-height: 30px;
    -unity-background-image-tint-color: rgb(255, 0, 0);
    flex-shrink: 0;
    justify-content: center;
}

#blood-splatter-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.5s;
    pointer-events: none;
    -unity-background-scale-mode: scale-to-fit;
}

#win-lose-menu {
    position: absolute;
    width: 100%;
    height: 100%;
    display: none;
    align-items: center;
    justify-content: center;
}

#win-lose-backdrop {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.75);
}

#win-lose-panel {
    /* Deep dark background with subtle warm tint */
    background-color: rgba(12, 8, 4, 0.98);
    border-width: 3px;
    border-color: rgb(218, 165, 32);
    border-radius: 2px;
    padding: 0px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    width: 560px;
    min-height: 400px;
    /* Outer glow effect using box-shadow not supported; use inner padding trick */
}

#panel-top-ornament {
    width: 100%;
    height: 8px;
    background-color: rgb(218, 165, 32);
    margin-bottom: 30px;
}

#panel-bottom-ornament {
    width: 100%;
    height: 8px;
    background-color: rgb(218, 165, 32);
    margin-top: 30px;
}

#result-icon {
    font-size: 52px;
    color: rgb(218, 165, 32);
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

#result-title {
    font-size: 80px;
    color: rgb(255, 215, 0);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 0px;
    /* Letterpress shadow effect */
    text-shadow: 0px 4px 0px rgb(80, 40, 0), 0px 8px 16px rgba(0,0,0,0.8);
}

#panel-divider {
    width: 80%;
    height: 2px;
    background-color: rgba(218, 165, 32, 0.5);
    margin-top: 16px;
    margin-bottom: 16px;
}

#result-subtitle {
    font-size: 22px;
    color: rgb(200, 180, 140);
    -unity-text-align: middle-center;
    margin-bottom: 28px;
    letter-spacing: 2px;
}

#panel-buttons {
    flex-direction: column;
    align-items: center;
    width: 100%;
}

.rome-button {
    width: 75%;
    height: 52px;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 230, 150);
    background-color: rgba(120, 30, 10, 0.9);
    border-width: 2px;
    border-color: rgb(218, 165, 32);
    border-radius: 2px;
    margin-bottom: 14px;
    letter-spacing: 3px;
    transition-duration: 0.15s;
}

.rome-button:hover {
    background-color: rgba(180, 50, 15, 1.0);
    border-color: rgb(255, 220, 80);
    color: white;
    scale: 1.04;
}

.rome-button-secondary {
    background-color: rgba(30, 30, 30, 0.9);
    color: rgb(180, 160, 120);
    border-color: rgba(150, 120, 60, 0.7);
}

.rome-button-secondary:hover {
    background-color: rgba(60, 55, 45, 0.95);
    border-color: rgb(218, 165, 32);
    color: rgb(220, 200, 150);
    scale: 1.03;
}

.rome-progress-bar {
    width: 100%;
    height: 25px;
    margin-bottom: 10px;
}

.rome-progress-bar .unity-progress-bar__container {
    height: 100%;
    min-height: 25px;
}

.rome-progress-bar .unity-progress-bar__background {
    background-color: rgba(30, 30, 30, 0.8);
    border-width: 2px;
    border-color: rgb(150, 150, 150);
    border-radius: 4px;
}

#player-health-bar .unity-progress-bar__progress {
    background-color: rgb(200, 30, 30); /* Dark Red for health */
    border-radius: 2px;
}

#player-stamina-bar .unity-progress-bar__progress {
    background-color: rgb(34, 139, 34); /* Forest Green for stamina */
    border-radius: 2px;
}

.stat-label {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(218, 165, 32); /* Gold */
    margin-bottom: 2px;
    margin-left: 2px;
}

#player-health-bar {
    width: 100%;
    height: 30px;
    min-height: 30px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    flex-shrink: 0;
    justify-content: center;
}

#player-stamina-bar {
    width: 100%;
    height: 30px;
    min-height: 30px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    flex-shrink: 0;
    justify-content: center;
}

#player-ammo-bar {
    width: 85%;
    height: 30px;
    min-height: 30px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    flex-shrink: 0;
    justify-content: center;
}

#ammo-container {
    display: flex;
    flex-direction: row;
    align-items: center; /* Vertically center items */
    justify-content: flex-end; /* Push everything to the right */
    margin-top: 5px;
    width: 100%;
}

#ammo-label {
    font-size: 16px;
    color: white;
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px rgb(0, 0, 0);
    margin-right: 10px; /* Space between label and bar */
    flex-shrink: 0; /* Prevent text from shrinking */
}

#weapon-type-label {
    font-size: 24px;
    color: white;
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px rgb(0, 0, 0);
    margin-bottom: 5px;
}

#weapon-icon {
    align-self: flex-end;
}

#reticle-container {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
}

#player-reticle {
    position: relative;
    width: 256px;
    height: 256px;
    -unity-background-scale-mode: scale-to-fit;
    background-size: 100% 100%;
    transform-origin: center;
}

/* Notification Container */
.notification-container {
    position: absolute;
    top: 20px;
    right: 20px;
    flex-direction: column;
    min-width: 200px;
    max-width: 350px;
    max-height: 200px;
}

.notification-item {
    flex-direction: column;
    background-color: rgba(22, 22, 24, 0.9);
    border-radius: 8px;
    padding: 8px 12px;
    margin-bottom: 6px;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.notification-item Label {
    color: rgb(229, 229, 229);
    font-size: 11px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}

.notification-fade-out {
    opacity: 0;
}

/* Low ammo warning style */
.low-ammo {
    color: rgb(255, 100, 0);
}

/* No ammo style */
.no-ammo {
    color: rgb(255, 0, 0);
}

#message-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

#message-label {
    font-size: 28px;
    color: white;
    -unity-font-style: bold;
    text-shadow: 0px 0px 10px rgba(0, 0, 0, 0.5);
    margin-bottom: 12px;
}

#countdown-label {
    font-size: 150px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    letter-spacing: -5px;
}

#message-divider {
    width: 194px;
    height: 4px;
    background-color: white;
    margin-bottom: -10px;
    align-self: center;
}

:root{
    --color-progressbar-background: rgba(16, 16, 16, 0.75);
    --color-progressbar-border-color: rgba(0, 0, 0, 0);
    --color-progressbar-fill: rgba(145, 213, 97, 0.75);
    --color-progressbar-text: rgb(255, 255, 255);
    --color-progressbar-text-low: rgb(255, 0, 0);
    --color-progressbar-ammo-blue: rgba(19, 181, 231, 0.75);
